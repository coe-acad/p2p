# Copy to .env.local and fill in for local development.
# Deployed values are configured in Vercel → Project Settings → Environment Variables.
# Production builds fail at startup if any backend URL below is missing.

# Backend URLs
VITE_BACKEND_URL=""
VITE_BAP_URL=""
VITE_PAYMENT_URL=""

# Firebase web app config (Firebase Console → Project settings → Your apps → Web → Config)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Dev only: "true" lets Firebase test phone numbers skip reCAPTCHA. Ignored by production builds.
VITE_DISABLE_PHONE_APP_VERIFICATION_FOR_TESTING=""
